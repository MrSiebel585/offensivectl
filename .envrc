# /opt/offensive/.envrc

# 1. Essential Core Paths
export OFFENSIVE_ROOT="/opt/offensive"
export OFFENSIVE_BIN_DIR="${OFFENSIVE_ROOT}/bin"
export OFFENSIVE_LOGS_DIR="${OFFENSIVE_ROOT}/logs"
export OFFENSIVE_PYTHON_DIR="${OFFENSIVE_ROOT}/python"
export OFFENSIVE_EXT_BACKUPS="${OFFENSIVE_ROOT}/backups/env"
export PATH="${OFFENSIVE_ROOT}/bin:${PATH}"

# Ensure backup directory exists
mkdir -p "$OFFENSIVE_EXT_BACKUPS"

# 2. Automated Environment Backup (Lightweight)
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
printenv > "${OFFENSIVE_EXT_BACKUPS}/env_${TIMESTAMP}.bak"
ls -t "${OFFENSIVE_EXT_BACKUPS}"/env_*.bak | tail -n +21 | xargs -r rm -- 2>/dev/null

# 3. Auto-Activate Python Virtual Environment
VENV_PATH="${OFFENSIVE_ROOT}/venv"
if [ -f "${VENV_PATH}/bin/activate" ]; then
    source "${VENV_PATH}/bin/activate"
fi

# 4. Non-Blocking Master Awareness Scan
if [ -f "${OFFENSIVE_ROOT}/offensivectl.py" ]; then
    python3 "${OFFENSIVE_ROOT}/offensivectl.py" scan >/dev/null 2>&1 &
fi
