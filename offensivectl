#!/usr/bin/env bash
# Route workflows, dfir, and osint to the fixed workflow registry helper.
# This early hook runs before root/PATH setup and ignores root overrides.
# OFFENSIVECTL_WORKFLOW_REGISTRY_HOOK_V1
if [[ "${1:-}" == "workflows" || "${1:-}" == "dfir" || "${1:-}" == "osint" ]]; then
    exec /usr/bin/env python3 "/opt/offensive/workflow_registry.py" "$@"
fi
# Route ai guide/summarize to the dedicated helper; summarise uses cmd_ai.
# OFFENSIVECTL_OLLAMA_DFIR_OSINT_HOOK_V1
if [[ "${1:-}" == "ai" && ( "${2:-}" == "guide" || "${2:-}" == "summarize" ) ]]; then
    action="$2"
    shift 2
    exec "/usr/local/bin/offensivectl-ai" "$action" "$@"
fi
# Kali OSINT/DFIR Modules Control Plane
# Usage: offensivectl [command] [options]
#
# Install location:
#   /opt/offensive/offensivectl
#
# Symlink:
#   /usr/local/bin/offensivectl -> /opt/offensive/offensivectl

# Preserve strict failure handling and pipeline status propagation.
set -euo pipefail

# Resolve installation symlinks before deriving workspace paths.
SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
    SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE_PATH")" && pwd)"
    SOURCE_PATH="$(readlink -- "$SOURCE_PATH")"
    [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH"
done

SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE_PATH")" && pwd)"
readonly SCRIPT_DIR
# OFFENSIVECTL_ROOT overrides the workspace; other directories derive from it.
readonly ROOT_DIR="${OFFENSIVECTL_ROOT:-$SCRIPT_DIR}"
readonly MODULES_DIR="$ROOT_DIR/modules"
readonly PROFILES_DIR="$ROOT_DIR/profiles"
readonly REPORTS_DIR="$ROOT_DIR/reports"
readonly LOGS_DIR="$ROOT_DIR/logs"
readonly REGISTRY_DIR="$ROOT_DIR/registry"
readonly OFFENSIVE_BIN="${OFFENSIVECTL_BIN:-$ROOT_DIR/bin}"
if [[ -n "${OFFENSIVECTL_LOCAL_BIN:-}" ]]; then
    readonly USER_LOCAL_BIN="$OFFENSIVECTL_LOCAL_BIN"
elif [[ -n "${HOME:-}" ]]; then
    readonly USER_LOCAL_BIN="$HOME/.local/bin"
else
    readonly USER_LOCAL_BIN=""
fi

if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
    readonly RED=$'\033[31m'
    readonly GREEN=$'\033[32m'
    readonly YELLOW=$'\033[33m'
    readonly BLUE=$'\033[34m'
    readonly NC=$'\033[0m'
else
    readonly RED=""
    readonly GREEN=""
    readonly YELLOW=""
    readonly BLUE=""
    readonly NC=""
fi
# shellcheck disable=SC2034
readonly OFFENSIVECTL_VERSION="1.2.0"

if [[ -d "$OFFENSIVE_BIN" && ":$PATH:" != *":$OFFENSIVE_BIN:"* ]]; then
    export PATH="$OFFENSIVE_BIN:$PATH"
fi

if [[ -n "$USER_LOCAL_BIN" && -d "$USER_LOCAL_BIN" && ":$PATH:" != *":$USER_LOCAL_BIN:"* ]]; then
    export PATH="$USER_LOCAL_BIN:$PATH"
fi

# Print short execution labels to stderr, keeping stdout available for results.
# Set OFFENSIVECTL_LABELS=0 to suppress these additional labels.
execution_label() {
    [[ "${OFFENSIVECTL_LABELS:-1}" != "0" ]] || return 0
    printf '[offensivectl] %s\n' "$*" >&2
}

# builtin_command_catalog: Read built-in command labels.
# Print command|description records for generated help.
builtin_command_catalog() {
    cat <<'CATALOG'
ask 'TASK'|Run a local forensic workflow described in plain English
chat|Start a guided forensic conversation
agent 'TASK'|Plan and run registered local evidence workflows
plan 'TASK'|Preview a forensic workflow without executing
list|List available modules
run MODULE|Run a module
profile NAME|Run a profile
report|Generate a case report
status|Show local service and workspace status
services status|Alias for status
dirs|Discover top-level workspace directories
interfaces|List/run UI or inspect network interfaces
launchers|List dynamically discovered launchers
load NAME|Run a dynamically discovered launcher
discover|Show directories, modules, and interfaces
doctor|Check installation health
registry|Rebuild/show the module registry
results|List and clean saved quick-results files
ai|Use the local Ollama assistant
lms|Manage the local LM Studio helper and API
quick|Run a bounded one-line workflow
kali|Proxy to kali-ones-offensive and Kali one-liners
kali-ones|Proxy to kali-ones-offensive
