# list_kali_one_liners: Show helper commands.
# Run the executable helper through Bash with --help, falling back to help.
list_kali_one_liners() {
    local kali_bin="$1"
    if [[ -x "$kali_bin" ]]; then
        bash "$kali_bin" --help 2>/dev/null || bash "$kali_bin" help 2>/dev/null
    else
        echo "kali-ones-offensive binary not executable: $kali_bin" >&2
        return 1
    fi
}

# cmd_kali_ones: Run requested Kali helper command.
# Resolve the helper and forward list/run/direct commands without case checks.
cmd_kali_ones() {
    execution_label "Run requested Kali helper command."
    local action="${1:-help}"
    shift || true

    local kali_bin
    kali_bin="$(resolve_kali_ones_bin)"
    [[ -x "$kali_bin" ]] || {
        echo "kali-ones-offensive not found under $ROOT_DIR or configured external paths" >&2
        exit 1
    }

    case "$action" in
        help|-h|--help)
            show_kali_ones_help
            ;;
        list)
            list_kali_one_liners "$kali_bin"
            ;;
        run)
            if [[ $# -lt 1 ]]; then
                echo "Usage: offensivectl kali run <command> [args...]" >&2
                exit 2
            fi
            bash "$kali_bin" "$@"
            ;;
        *)
            bash "$kali_bin" "$action" "$@"
            ;;
    esac
}

