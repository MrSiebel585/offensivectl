# cmd_lms: Handle LM Studio request.
# Route server/model actions to the helper; models/test call the HTTP API.
cmd_lms() {
    execution_label "Handle LM Studio request."
    local action="${1:-status}"
    local base_url="${LMS_BASE_URL:-http://127.0.0.1:1234}"
    local lms_script=""
    [[ $# -gt 0 ]] && shift

    case "$action" in
        status|start|load|pull|reload)
            lms_script="$(resolve_lms_helper)"
            [[ -x "$lms_script" ]] || {
                echo "[ERROR] LMS helper not found under configured workspace paths" >&2
                return 1
            }
            case "$action" in
                status) "$lms_script" --status "$@" ;;
                start) "$lms_script" --server-only "$@" ;;
                load) LMS_GPU="${LMS_GPU:-}" "$lms_script" --load --no-server "$@" ;;
                pull) "$lms_script" --pull --no-server "$@" ;;
                reload) LMS_GPU="${LMS_GPU:-}" "$lms_script" --pull --load "$@" ;;
            esac
            ;;
        models)
            curl --silent --show-error "${base_url%/}/v1/models"
            echo
            ;;
        test)
            curl --silent --show-error "${base_url%/}/v1/chat/completions" \
                -H "Content-Type: application/json" --data-binary @- <<'EOF'
{
  "model": "mistralai/mistral-7b-instruct-v0.3",
  "messages": [
    {
      "role": "user",
      "content": "Say Omniscient LMS is online in one sentence."
    }
  ],
  "temperature": 0.2,
  "max_tokens": 80
}
EOF
            echo
            ;;
        help|-h|--help)
            cat <<'HELP'
Usage:
  offensivectl lms status|start|load|pull|reload
  offensivectl lms models|test

Overrides: OFFENSIVECTL_LMS_SCRIPT, LMS_BASE_URL, LMS_GPU
HELP
            ;;
        *)
            echo "Unknown LMS action: $action" >&2
            return 2
            ;;
    esac
}

# cmd_vuln: Route local vulnerability research.
# Map case, target, inspection, crash, assessment, and report actions to cmd_run.
cmd_vuln() {
    execution_label "Route local vulnerability research."
    local area="${1:-help}"
    [[ $# -gt 0 ]] && shift

    case "$area" in
        case)
            local case_action="${1:-help}"
            [[ $# -gt 0 ]] && shift
            case "$case_action" in
                init|new|open)
                    cmd_run vulnerability.research --target case-init "$@"
                    ;;
                status|show)
                    cmd_run vulnerability.research --target status "$@"
                    ;;
                *)
                    echo "Usage: offensivectl vuln case init|status --case CASE-ID --authorization ID" >&2
                    return 2
                    ;;
            esac
            ;;
        target)
            local target_action="${1:-help}"
            [[ $# -gt 0 ]] && shift
            case "$target_action" in
                add|import)
                    local input_file="${1:-}"
                    [[ -n "$input_file" && "$input_file" != --* ]] || {
                        echo "Usage: offensivectl vuln target add FILE --case CASE-ID --authorization ID" >&2
                        return 2
                    }
                    shift
                    cmd_run vulnerability.research --target target-add --input "$input_file" "$@"
                    ;;
                *)
                    echo "Usage: offensivectl vuln target add FILE --case CASE-ID --authorization ID" >&2
                    return 2
                    ;;
            esac
            ;;
        inspect|protections)
            cmd_run vulnerability.research --target inspect "$@"
            ;;
        crash)
            local crash_action="${1:-help}"
            [[ $# -gt 0 ]] && shift
            case "$crash_action" in
                import)
                    local crash_file="${1:-}"
                    [[ -n "$crash_file" && "$crash_file" != --* ]] || {
                        echo "Usage: offensivectl vuln crash import FILE --case CASE-ID --authorization ID" >&2
                        return 2
                    }
                    shift
                    cmd_run vulnerability.research --target crash-import --input "$crash_file" "$@"
                    ;;
                analyze)
                    cmd_run vulnerability.research --target crash-analyze "$@"
                    ;;
                *)
                    echo "Usage: offensivectl vuln crash import FILE|analyze --case CASE-ID --authorization ID" >&2
                    return 2
                    ;;
            esac
            ;;
        exploitability)
            [[ "${1:-}" == "assess" ]] || {
                echo "Usage: offensivectl vuln exploitability assess --case CASE-ID --authorization ID" >&2
                return 2
            }
            shift
            cmd_run vulnerability.research --target assess "$@"
            ;;
        assess)
            cmd_run vulnerability.research --target assess "$@"
            ;;
        report)
            cmd_run vulnerability.research --target report "$@"
            ;;
        status)
            cmd_run vulnerability.research --target status "$@"
            ;;
        help|-h|--help)
            cat <<'HELP'
Usage:
  offensivectl vuln case init --case CASE-ID --authorization ID [--title TEXT]
  offensivectl vuln case status --case CASE-ID --authorization ID
  offensivectl vuln target add FILE --case CASE-ID --authorization ID [--label TEXT]
  offensivectl vuln inspect --case CASE-ID --authorization ID [--target-id ID]
  offensivectl vuln crash import FILE --case CASE-ID --authorization ID [--label TEXT]
  offensivectl vuln crash analyze --case CASE-ID --authorization ID [--crash-id ID]
  offensivectl vuln exploitability assess --case CASE-ID --authorization ID
  offensivectl vuln report --case CASE-ID --authorization ID

Vulnerability Research v0.1 performs local evidence intake, bounded static
inspection, crash-text triage, conservative assessment, and reporting. It does
not execute imported targets, fuzz processes, generate exploits or payloads, or
access network targets.
HELP
            ;;
        *)
            echo "Unknown vuln command: $area" >&2
            echo "Use: offensivectl vuln --help" >&2
            return 2
            ;;
    esac
}

# cmd_registry: Handle module index request.
# rebuild overwrites modules.tsv; show displays the existing snapshot.
cmd_registry() {
    execution_label "Handle module index request."
    local action="${1:-help}"
    shift || true

    case "$action" in
        rebuild)
            mkdir -p "$REGISTRY_DIR"

            local registry_file="$REGISTRY_DIR/modules.tsv"

            printf 'module_name\tcategory\tmodule\tpath\tmode\trisk_level\tdescription\n' > "$registry_file"

            local module_yaml module_dir
            while IFS= read -r -d '' module_yaml; do
                module_dir="${module_yaml%/module.yaml}"
                local relative
                local category
                local module
                local module_name
                local mode
                local risk
                local description

                relative="${module_dir#"$MODULES_DIR"/}"
                category="${relative%%/*}"
                module="${relative#*/}"
                module_name="$(module_name_from_dir "$module_dir")"
                mode="$(yaml_value mode "$module_yaml")"
                risk="$(yaml_value risk_level "$module_yaml")"
                description="$(yaml_value description "$module_yaml")"

                printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                    "$module_name" \
                    "$category" \
                    "$module" \
                    "$module_dir" \
                    "$mode" \
                    "$risk" \
                    "$description" >> "$registry_file"
            done < <(module_manifest_files)

            echo "Registry rebuilt:"
            echo "$registry_file"
            ;;
        show)
            local registry_file="$REGISTRY_DIR/modules.tsv"

            [[ -f "$registry_file" ]] || {
                echo "Registry missing. Run: offensivectl registry rebuild" >&2
                exit 1
            }

            if command -v column >/dev/null 2>&1; then
                column -t -s $'\t' "$registry_file"
            else
                cat "$registry_file"
            fi
            ;;
        help|--help|-h)
            cat <<HELP
Usage:
  offensivectl registry rebuild
  offensivectl registry show
HELP
            ;;
        *)
            echo "Unknown registry action: $action" >&2
            exit 1
            ;;
    esac
}

# cmd_results: Handle saved results.
# List or delete quick outputs; existing listing and clean bugs remain unchanged.
cmd_results() {
    execution_label "Handle saved results."
    local action="${1:-list}"
    local results_dir="$ROOT_DIR/results"

    case "$action" in
        list)
            if [[ ! -d "$results_dir" ]]; then
                echo "No saved quick results found." >&2
                return 0
            fi
            printf '%-4s  %-20s  %-8s  %s\n' "#" "UPDATED" "SIZE" "FILE"
            printf '%-4s  %-20s  %-8s  %s\n' "----" "-------------------" "--------" "----"
            local idx=0 file
            while IFS= read -r -d '' file; do
                idx=$((idx + 1))
                printf '%-4s  %-20s  %-8s  %s\n' \
                    "$idx" \
                    "$(date -r "$file" '+%Y-%m-%d %H:%M:%S')" \
                    "$(stat -c '%s' "$file")" \
                    "${file#$ROOT_DIR/}"
            # Existing defect: read expects NUL, but this producer emits newlines.
            done < <(find "$results_dir" -maxdepth 1 -type f | LC_ALL=C sort)
            ;;
        delete)
            if [[ -z "${2:-}" ]]; then
                echo "Usage: offensivectl results delete <file>" >&2
                return 2
            fi
            local target="$2"
            # Existing limitation: target is not confined against path traversal.
            local path="$results_dir/$target"
            if [[ ! -f "$path" ]]; then
                echo "Result file not found: $target" >&2
                return 1
            fi
            rm -f -- "$path"
            echo "Deleted $target"
            ;;
        clean)
            # Existing defect: action was not shifted; clean is rejected by the loop.
            local older_than=30
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --older-days)
                        require_option_value "$1" "${2:-}" || return 2
                        older_than="$2"
                        shift 2
                        ;;
                    --all)
                        older_than=0
                        shift
                        ;;
                    -h|--help)
                        echo "Usage: offensivectl results clean [--older-days N] [--all]"
                        return 0
                        ;;
                    *)
                        echo "Unknown results clean option: $1" >&2
                        return 2
                        ;;
                esac
            done
            if [[ ! -d "$results_dir" ]]; then
                echo "No saved quick results to clean." >&2
                return 0
            fi
            if [[ "$older_than" -eq 0 ]]; then
                find "$results_dir" -maxdepth 1 -type f -print0 | xargs -0 rm -f --
                echo "Removed all saved quick results."
                return 0
            fi
            local removed=0 file
            while IFS= read -r -d '' file; do
                rm -f -- "$file"
                removed=$((removed + 1))
            done < <(find "$results_dir" -maxdepth 1 -type f -mtime +$older_than -print0)
            echo "Removed $removed result file(s) older than $older_than days."
            ;;
        help|-h|--help)
            cat <<HELP
Usage: offensivectl results <action> [options]

Actions:
  list                     List saved quick result files
  delete <file>            Delete a saved result file
  clean [--older-days N]   Remove result files older than N days
  clean --all              Remove all saved result files
HELP
            ;;
        *)
            echo "Unknown results action: $action" >&2
            echo "Run: offensivectl results help" >&2
            return 1
            ;;
    esac
}

