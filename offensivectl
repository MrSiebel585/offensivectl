# ──────────────────────────────────────────────
# Quick one-liner workflows
# ──────────────────────────────────────────────
# cmd_quick: Run selected quick workflow.
# Collect tool output; optionally save it and request an AI summary.
cmd_quick() {
    execution_label "Run selected quick workflow."
    # Handle --help before anything
    for arg in "$@"; do
        if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
            cat <<HELP
Usage: offensivectl quick <workflow> [options] [target]

Workflows:
  dns-recon <domain>       DNS recon: dig + whois + subfinder
  port-scan <target>       Quick port scan with nmap
  vuln-scan <target>       Vulnerability scan using nmap NSE vuln scripts
  web-tech <url>           Identify web technologies
  subdomains <domain>      Passive subdomain discovery
  kali-scan <target>       Quick nmap-based Kali-style scan
  kali-dns <domain>         DNS + whois + passive subdomain discovery
  kali-webtech <url>        Web-tech fingerprinting with curl/whatweb

Options:
  --ai            Pipe output through Ollama AI summarisation
  --model NAME    Ollama model for AI summarisation
  --target T      Explicitly specify target
  --save          Save output to a default quick-results file
  --save-file F   Write output to the specified file
  -h, --help      Show this help

Examples:
  offensivectl quick dns-recon example.com
  offensivectl quick port-scan 192.168.1.1
  offensivectl quick web-tech https://example.com --ai
  offensivectl quick subdomains example.com --model gemma4:12b
HELP
            exit 0
        fi
    done

    # Quick workflows do not use cmd_run case, scope, or authorization checks.
    local workflow="${1:-}"
    shift || true

    local target=""
    local use_ai=false
    local ai_args=()
    local save_output=false
    local save_file=""

    # Parse common options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ai) use_ai=true; shift ;;
            --model)
                require_option_value "$1" "${2:-}" || exit $?
                ai_args+=(--model "$2")
                shift 2
                ;;
            --target)
                require_option_value "$1" "${2:-}" || exit $?
                target="$2"
                shift 2
                ;;
            --save)
                save_output=true
                shift
                ;;
            --save-file)
                require_option_value "$1" "${2:-}" || exit $?
                save_file="$2"
                shift 2
                ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$1"
                fi
                shift ;;
        esac
    done

    [[ -n "$target" ]] || {
        echo -e "${RED}[ERROR]${NC} Target is required" >&2
        echo "Usage: offensivectl quick <workflow> [options] [target]" >&2
        echo "Try: offensivectl quick --help" >&2
        exit 1
    }

    local tmpfile
    tmpfile="$(mktemp)"
    trap 'rm -f "$tmpfile"' RETURN

    case "$workflow" in
        dns-recon)
            echo -e "${BLUE}[*]${NC} DNS Recon on: $target"
            echo "============================================" > "$tmpfile"

            if command -v dig &>/dev/null; then
                echo -e "${GREEN}[+]${NC} Running dig..."
                {
                    echo "=== DIG A Record ==="
                    dig +short A "$target" 2>&1
                    echo ""
                    echo "=== DIG MX Records ==="
                    dig +short MX "$target" 2>&1
                    echo ""
                    echo "=== DIG NS Records ==="
                    dig +short NS "$target" 2>&1
                    echo ""
                    echo "=== DIG TXT Records ==="
                    dig +short TXT "$target" 2>&1
                } >> "$tmpfile"
            else
                echo -e "${YELLOW}[!]${NC} dig not installed, skipping" >> "$tmpfile"
            fi

            if command -v whois &>/dev/null; then
                echo -e "${GREEN}[+]${NC} Running whois..."
                {
                    echo ""
                    echo "=== WHOIS ==="
                    timeout 10 whois "$target" 2>&1 | head -50
                } >> "$tmpfile"
            else
                echo -e "${YELLOW}[!]${NC} whois not installed, skipping"
            fi

            if command -v subfinder &>/dev/null; then
                echo -e "${GREEN}[+]${NC} Running subfinder..."
                {
                    echo ""
                    echo "=== SUBFINDER ==="
                    subfinder -d "$target" -silent 2>&1 || true
                } >> "$tmpfile"
            else
                echo -e "${YELLOW}[!]${NC} subfinder not installed, skipping"
            fi
            ;;

        port-scan)
            echo -e "${BLUE}[*]${NC} Port scan on: $target"
            echo "============================================" > "$tmpfile"
            echo "=== NMAP Quick Scan ===" >> "$tmpfile"

            if command -v nmap &>/dev/null; then
                echo -e "${GREEN}[+]${NC} Running nmap (top 1000 ports)..."
                nmap -T4 --top-ports 1000 --open "$target" 2>&1 | tail -30 >> "$tmpfile"
            else
                echo -e "${YELLOW}[!]${NC} nmap not installed" >> "$tmpfile"
            fi
            ;;

        vuln-scan)
            echo -e "${BLUE}[*]${NC} Vulnerability scan on: $target"
            echo "============================================" > "$tmpfile"
            echo "=== NMAP Vulnerability Scan ===" >> "$tmpfile"

            if command -v nmap &>/dev/null; then
                echo -e "${GREEN}[+]${NC} Running nmap with NSE vuln scripts..."
                nmap -T4 --script vuln --script-args vulns.showall=1 "$target" 2>&1 >> "$tmpfile"
            else
                echo -e "${YELLOW}[!]${NC} nmap not installed" >> "$tmpfile"
            fi
            ;;

        web-tech)
            echo -e "${BLUE}[*]${NC} Web tech detection on: $target"
            echo "============================================" > "$tmpfile"

            if command -v whatweb &>/dev/null; then
                echo -e "${GREEN}[+]${NC} Running whatweb..."
                echo "=== WHATWEB ===" >> "$tmpfile"
                whatweb "$target" --aggression 1 >> "$tmpfile" 2>&1 || true
            fi

            {
                echo ""
                echo "=== CURL Headers ==="
            } >> "$tmpfile"
            curl -sI -L --max-time 10 "$target" >> "$tmpfile" 2>&1 || echo "curl failed" >> "$tmpfile"

            echo "" >> "$tmpfile"
            echo "=== CURL Body (first 20 lines) ===" >> "$tmpfile"
            curl -sL --max-time 10 "$target" 2>&1 | head -20 >> "$tmpfile"
            ;;

        subdomains)
            echo -e "${BLUE}[*]${NC} Subdomain discovery on: $target"
            echo "============================================" > "$tmpfile"

            if command -v subfinder &>/dev/null; then
                echo -e "${GREEN}[+]${NC} Running subfinder..."
                echo "=== SUBFINDER ===" >> "$tmpfile"
                subfinder -d "$target" -silent >> "$tmpfile" 2>&1 || true
            fi

            echo "" >> "$tmpfile"
            if command -v amass &>/dev/null; then
                echo -e "${GREEN}[+]${NC} Running amass (passive)..."
                echo "=== AMASS ===" >> "$tmpfile"
                amass enum -passive -d "$target" 2>&1 | head -100 >> "$tmpfile" || true
            else
                echo -e "${YELLOW}[!]${NC} amass not installed, skipping"
            fi
            ;;

        kali-scan)
            echo -e "${BLUE}[*]${NC} Kali quick scan on: $target"
            echo "============================================" > "$tmpfile"
            if command -v nmap &>/dev/null; then
                echo -e "${GREEN}[+]${NC} Running nmap..."
                nmap -T4 --top-ports 1000 --open "$target" 2>&1 >> "$tmpfile"
            else
                echo -e "${YELLOW}[!]${NC} nmap not installed" >> "$tmpfile"
            fi
            ;;

        kali-dns)
            echo -e "${BLUE}[*]${NC} Kali DNS recon on: $target"
            echo "============================================" > "$tmpfile"
            if command -v dig &>/dev/null; then
                echo "=== DIG A Records ===" >> "$tmpfile"
                dig +short A "$target" 2>&1 >> "$tmpfile"
            fi
            if command -v whois &>/dev/null; then
                echo "" >> "$tmpfile"
                echo "=== WHOIS ===" >> "$tmpfile"
                timeout 10 whois "$target" 2>&1 | head -50 >> "$tmpfile"
            fi
            if command -v subfinder &>/dev/null; then
                echo "" >> "$tmpfile"
                echo "=== SUBFINDER ===" >> "$tmpfile"
                subfinder -d "$target" -silent >> "$tmpfile" 2>&1 || true
            fi
            ;;

        kali-webtech)
            echo -e "${BLUE}[*]${NC} Web tech detection on: $target"
            echo "============================================" > "$tmpfile"
            if command -v whatweb &>/dev/null; then
                echo "=== WHATWEB ===" >> "$tmpfile"
                whatweb "$target" --aggression 1 >> "$tmpfile" 2>&1 || true
            fi
            echo "" >> "$tmpfile"
            echo "=== CURL HEADERS ===" >> "$tmpfile"
            curl -sI -L --max-time 10 "$target" >> "$tmpfile" 2>&1 || echo "curl failed" >> "$tmpfile"
            ;;

        *)
            echo -e "${RED}[ERROR]${NC} Unknown workflow: $workflow" >&2
            echo "Use: offensivectl quick --help for available workflows"
            exit 1
            ;;
    esac

    echo ""
    echo -e "${GREEN}[SUCCESS]${NC} Results:"
    echo ""
    cat "$tmpfile"

    if [[ "$save_output" == true || -n "$save_file" ]]; then
        local outdir="$ROOT_DIR/results"
        mkdir -p "$outdir"
        local timestamp
        timestamp="$(date -u +'%Y%m%dT%H%M%SZ')"
        local default_file="$outdir/quick-${workflow// /_}-${target//[^a-zA-Z0-9_-]/_}-${timestamp}.txt"
        local dest="${save_file:-$default_file}"

        if [[ -z "$save_file" ]]; then
            echo -e "${BLUE}[*]${NC} Saving output to ${dest}"
        else
            echo -e "${BLUE}[*]${NC} Saving output to custom file ${dest}"
        fi

        if ! cp "$tmpfile" "$dest" 2>/dev/null; then
            echo -e "${RED}[ERROR]${NC} Failed to save output to ${dest}" >&2
        fi
    fi

    if [[ "$use_ai" == true ]]; then
        echo ""
        echo -e "${BLUE}[*]${NC} Sending output to Ollama for analysis..."
        local ai_bin="$OFFENSIVE_BIN/offensive-ai"
        if [[ -x "$ai_bin" ]]; then
            bash "$ai_bin" summarise "${ai_args[@]}" "$(cat "$tmpfile")" || true
        else
            echo -e "${YELLOW}[!]${NC} offensive-ai not found, skipping AI analysis"
        fi
    fi
}

# main: Route command to selected handler.
# Dispatch built-ins and launchers; qualifying unknown input reaches the assistant.
main() {
    if [[ $# -eq 0 && -t 0 ]]; then
        exec /usr/bin/env python3 "$ROOT_DIR/forensic_assistant.py" chat
    fi
    local command="${1:-help}"
    shift || true

    case "$command" in
        ask|chat|agent|plan)
            exec /usr/bin/env python3 "$ROOT_DIR/forensic_assistant.py" "$command" "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        run)
            cmd_run "$@"
            ;;
        profile)
            cmd_profile "$@"
            ;;
        report)
            cmd_report "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        services)
            if [[ "${1:-status}" != "status" ]]; then
                echo "Unknown services action: ${1:-}" >&2
                echo "Usage: offensivectl services status [--strict] [--timeout SECONDS]" >&2
                exit 1
            fi
            [[ $# -gt 0 ]] && shift
            cmd_status "$@"
            ;;
        dirs|directories)
            cmd_dirs "$@"
            ;;
        interface|interfaces)
            cmd_interfaces "$@"
            ;;
        launcher|launchers|apps)
            cmd_interfaces list "$@"
            ;;
        load|launch)
            cmd_interfaces run "$@"
            ;;
        discover)
            cmd_discover "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        registry)
            cmd_registry "$@"
            ;;
        results)
            cmd_results "$@"
            ;;
        ai)
            cmd_ai "$@"
            ;;
        quick)
            cmd_quick "$@"
            ;;
        lms)
            cmd_lms "$@"
            ;;
        kali-ones|kaliones|kali)
            cmd_kali_ones "$@"
            ;;
        vuln|vulnerability|vulnerability-research)
            cmd_vuln "$@"
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            if resolve_interface "$command" >/dev/null 2>&1; then
                cmd_interfaces run "$command" "$@"
            elif [[ "$command" == *" "* || $# -gt 0 ]] && [[ "$command" != -* ]]; then
                exec /usr/bin/env python3 "$ROOT_DIR/forensic_assistant.py" "$command" "$@"
            else
                echo "Unknown command or launcher: $command" >&2
                usage
                exit 1
            fi
            ;;
    esac
}

main "$@"
